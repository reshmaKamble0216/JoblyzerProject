@model JobLyzerProject.ViewModels.RegisterAdminViewModel
@{
    ViewData["Title"] = "System Administration Access Gate";
}

<style>
    /* Centers the admin security card nicely on the screen view */
    .admin-center-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-container-admin {
        max-width: 480px;
        width: 100%;
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .auth-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        font-size: 0.88rem;
        color: #64748b;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #0f172a;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .form-input:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
            outline: none;
        }

    .security-badge-divider {
        border-bottom: 2px solid #ef4444;
        margin: 5px 0 20px 0;
        padding-bottom: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #dc3545;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-submit {
        background-color: #dc3545;
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .btn-submit:hover {
            background-color: #bb2d3b;
        }

    .text-center-link {
        text-align: center;
        margin-top: 20px;
        font-size: 0.88rem;
    }

        .text-center-link a {
            color: #dc3545;
            text-decoration: none;
            font-weight: 500;
        }

            .text-center-link a:hover {
                text-decoration: underline;
            }

    .text-danger {
        color: #ef4444;
        font-size: 0.82rem;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="admin-center-wrapper">
    <div class="auth-container-admin">
        <div class="auth-header">
            <h3 class="auth-title">Admin Registration</h3>
        </div>

        <form asp-action="RegisterAdmin" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Administrator Email Address</label>
                <input asp-for="Email" class="form-input" placeholder="admin@joblyzer.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-input" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Register Admin</button>
        </form>

        <div class="text-center-link">
            <a asp-action="Login">Cancel & Return to Login Portal</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
