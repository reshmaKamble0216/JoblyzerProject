@model JobLyzerProject.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Authentication Portal";
}

<style>
    /* Centers the login card on the screen canvas area */
    .login-center-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-container {
        max-width: 450px;
        width: 100%;
        background: #ffffff;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        box-sizing: border-box;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        font-size: 0.9rem;
        color: #64748b;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .form-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
        box-sizing: border-box;
    }

        .form-input:focus {
            border-color: #3b82f6;
            outline: none;
        }

    .btn-submit {
        background-color: #2563eb;
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .role-selection-zone {
        border-top: 1px solid #e2e8f0;
        margin-top: 25px;
        padding-top: 20px;
        text-align: center;
    }

    .role-links-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .role-btn {
        display: block;
        padding: 10px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        color: #334155;
        text-decoration: none;
        font-size: 0.9rem;
    }

        .role-btn:hover {
            background-color: #f8fafc;
            color: #2563eb;
        }

    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
    }
</style>

<div class="login-center-wrapper">
    <div class="auth-container">
        <div class="auth-header">
            <h3 class="auth-title">Welcome Back</h3>
            <p class="auth-subtitle">Sign in to manage your Joblyzer account</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-input" placeholder="name@domain.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-input" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-submit">Sign In</button>
        </form>

        <div class="role-selection-zone">
            <div class="role-links-grid">
                <a asp-action="RegisterStudent" class="role-btn">Sign up as Student</a>
                <a asp-action="RegisterRecruiter" class="role-btn">Sign up as Recruiter</a>
                <a asp-action="RegisterAdmin" class="role-btn">Sign up as Admin</a>
            </div>
        </div>
    </div>
</div>
